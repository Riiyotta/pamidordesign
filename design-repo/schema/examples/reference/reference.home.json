      "section": "art.lab-teaser",
      "content": {
        "title": "The Art Lab",
        "cards": [
          {
            "image": {
              "assetRole": "owner-artwork",
              "alt": "Art Lab - personal illustration work"
            },
            "body": "Let’s get one thing straight, I don't always play nicely within the lines. Welcome to my creative playground, This space is my unapologetic tribute to pure, unfiltered art. It’s where I completely ditch the grid, smash conventional aesthetics, and let my weirdest, most colorful thoughts run wildly out of control."
          },
          {
            "image": {
              "assetRole": "owner-artwork",
              "alt": "Art Lab - paintings and visual experiments"
            },
            "body": "Think of this section as a beautiful, chaotic dump of my personal illustrations, bold paintings, and non-stop visual experiments. It’s loud, it’s a little bit rebellious, and it’s driven entirely by raw creative instinct. No logic, no constraints, just pure art making a mess. Care to take a peek inside the madness?"
          }
        ],
        "actions": [
