          "Technology & SaaS",
          "Artificial Intelligence",
          "Fintech",
          "Cybersecurity",
          "AdTech",
          "Consumer Brands",
          "Digital Products"
        ],
        "question": "Which industries do you work in?",
        "answer": "I work mostly in technology and SaaS, artificial intelligence, fintech, cybersecurity, adtech, consumer brands and digital products."
      },
      "motion": {
        "pattern": "marquee-loop",
        "reducedMotionFallback": "static-row"
