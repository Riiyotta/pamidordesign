    {
      "section": "narrative.process-steps",
      "content": {
        "title": "What does working with you look like?",
        "intro": "Most projects move through five stages, adapted to what each one actually needs. The process is flexible and changes with the kind of project - not every one needs all five stages, and some spend most of their time in just one or two of them.",
        "steps": [
          {
            "index": "01",
            "title": "Discovery & Research",
            "body": "Understanding the business, its audience, challenges, and goals."
          },
          {
            "index": "02",
            "title": "Strategy & Direction",
            "body": "Defining the creative direction, design approach, and project priorities."
          },
          {
            "index": "03",
            "title": "Concept & Exploration",
            "body": "Exploring visual ideas, structures, interactions, and possible solutions."
          },
          {
            "index": "04",
            "title": "Design & Development",
            "body": "Turning selected concepts into complete visual identities, interfaces, or digital experiences."
          },
          {
            "index": "05",
            "title": "Refinement & Delivery",
            "body": "Testing, refining, and preparing the final design assets for implementation."
          }
        ]
      },
      "motion": {
        "pattern": "reveal-rise",
        "reducedMotionFallback": "static-final-state"
      }
    },
    {
      "section": "narrative.faq",
      "content": {
        "eyebrow": "(Questions)",
        "items": [
          {
            "question": "What do you specialize in?",
            "answer": "I focus on digital product design, brand identity and visual systems, combining UX/UI with strong visual direction."
          },
          {
            "question": "Do you work with startups?",
            "answer": "Yes - I work with early-stage startups, growing companies and established brands, and also with independent clients."
          },
          {
            "question": "Do you work internationally?",
            "answer": "Yes - I’m based in Tel Aviv and work with clients both in Israel and around the world."
          },
          {
            "question": "Can you handle both branding and product design?",
            "answer": "Yes - I can develop a visual identity and carry its design language into digital products and interfaces."
          },
          {
            "question": "Do you offer 3D and motion design?",
            "answer": "Yes - I use 3D, motion and digital illustration when they add value to the project, not as decoration laid on top of it."
          },
          {
            "question": "How do projects usually start?",
            "answer": "With a conversation about the idea, the challenges, the scope and what needs to be achieved."
          }
        ]
      },
