    {
      "section": "narrative.approach-statement",
      "content": {
        "statement": "I combine persistence, creative thinking, and attention to detail to solve problems through visual design.",
        "question": "What makes your approach different?",
        "answer": "I combine product thinking with a strong background in visual design, branding and art direction, and I enjoy solving complex problems through visual ideas that challenge both how people see and how they feel."
      },
      "motion": {
        "pattern": "scroll-char-wave",
        "reducedMotionFallback": "fully-lit-static"
      }
    },
    {
